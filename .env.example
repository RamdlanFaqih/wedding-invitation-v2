# Local UI runs without external services. Guestbook is explicitly a local demo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Reserved for the next milestone; not connected by this UI starter.
DATABASE_URL=
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional admin overrides. Defaults: admin / admin123. Server-only values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set a long random value in Vercel for independent session signing.
ADMIN_SESSION_SECRET=
